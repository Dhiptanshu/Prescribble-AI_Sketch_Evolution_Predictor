# Copy to deploy/.env and fill in. Never commit the real file. Every variable is explained in docs/DEPLOY.md.
SECRET_KEY=            # required: python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false    # true when served over HTTPS (always in production)
# Behind a reverse proxy:
# FORWARDED_ALLOW_IPS=172.18.0.1            # the proxy's address, so the real client IP reaches the rate limits
# TRUSTED_ORIGINS=["https://prescribble.example"]   # only if the proxy rewrites the Host header
# Optional PostgreSQL (use with --profile postgres):
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://prescribble:<password>@db:5432/prescribble
