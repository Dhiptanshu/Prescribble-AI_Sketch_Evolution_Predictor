# Copy to deploy/.env and fill in. Never commit the real file.
SECRET_KEY=            # e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false    # true when served over HTTPS
# Optional PostgreSQL (use with --profile postgres):
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://prescribble:<password>@db:5432/prescribble
